# Copy to .env.local and fill in. .env.local is gitignored.
# Firebase console → Project settings → General → Your apps → Web app → Config.
# These are public identifiers, not secrets; App Check + Security Rules protect the backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check: reCAPTCHA Enterprise SCORE-BASED site key (Google Cloud → Security → reCAPTCHA).
# Add your Hosting domains to the key. Do NOT add localhost; use the debug provider below instead.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# App Check DEBUG settings go in a SEPARATE file: .env.development.local
# (Vite loads it only for `npm run dev`, never for `npm run build`, so a debug
# token can never end up in a production bundle). Put these two lines there:
#
#   VITE_APPCHECK_DEBUG=true
#   VITE_APPCHECK_DEBUG_TOKEN=<any UUID, e.g. from `uuidgen`>
#
# Register that UUID in Firebase console → App Check → Apps → ⋮ → Manage debug tokens.
# ─────────────────────────────────────────────────────────────────────────────
